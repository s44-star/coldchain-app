{
  "name": "coldchain-app",
  "version": "0.1.0",
  "private": true,
  "description": "ColdChain OS — multi-tenant cold-chain monitoring and operations SaaS by LexConv",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "./supabase/tests/run.sh",
    "db:bundle": "./scripts/bundle-sql.sh",
    "db:types:local": "PGDATABASE=coldchain_test python3 scripts/gen-db-types.py > src/types/database.ts",
    "db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" --schema public > src/types/database.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "clsx": "^2.1.1",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
