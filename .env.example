# =============================================================================
# ColdChain OS environment variables
# Copy to .env.local for local development. In Vercel: Project → Settings →
# Environment Variables. Never commit real values.
#
# NEXT_PUBLIC_* values are sent to the browser. Everything else stays on the
# server. Supabase keys are under Project Settings → API Keys.
# =============================================================================

# --- Required from Stage 1 ----------------------------------------------------

# Supabase project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Safe in the browser: RLS protects data.
# Legacy projects can use the "anon" key here instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). SERVER ONLY. Bypasses RLS; used only by webhooks,
# sensor ingestion and cron jobs. Legacy projects: the "service_role" key.
SUPABASE_SECRET_KEY=

# Public address of the app, used for links in e-mails and auth redirects.
# Production: https://coldchain-app-z971.vercel.app (later https://coldchain.lexconv.com)
NEXT_PUBLIC_SITE_URL=

# --- Stage 3: monitoring ---------------------------------------------------------

# Long random string protecting /api/cron/* (Vercel Cron sends it as a Bearer token).
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Stage 4: notifications (optional) -------------------------------------------

# Without these, e-mails are recorded as "not sent: no provider configured".
RESEND_API_KEY=
EMAIL_FROM="ColdChain OS <alerts@lexconv.com>"

# --- Stage 5: payments (Razorpay) ----------------------------------------------

# Key ID is public (used by Checkout in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# SERVER ONLY
RAZORPAY_KEY_SECRET=
# SERVER ONLY — the secret you set when creating the webhook in Razorpay
RAZORPAY_WEBHOOK_SECRET=
